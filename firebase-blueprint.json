{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "Student or staff profile for APU EcoCarry",
      "type": "object",
      "properties": {
        "studentName": { "type": "string", "maxLength": 100 },
        "studentId": { "type": "string", "maxLength": 50 },
        "faculty": { "type": "string", "maxLength": 100 },
        "tier": { "type": "string", "maxLength": 50 },
        "points": { "type": "number" },
        "activeStreak": { "type": "number" },
        "bagsSavedTotal": { "type": "number" },
        "co2SavedKg": { "type": "number" },
        "email": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentName", "studentId", "email"]
    },
    "globalBag": {
      "title": "GlobalBag",
      "description": "Individual physical reusable bag in campus circulation",
      "type": "object",
      "properties": {
        "bagNumber": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["available", "borrowed", "maintenance"] },
        "currentBorrowerId": { "type": "string", "maxLength": 128 },
        "currentBorrowerName": { "type": "string", "maxLength": 100 },
        "borrowedStationId": { "type": "string", "maxLength": 50 },
        "borrowedStationName": { "type": "string", "maxLength": 100 },
        "qrToken": { "type": "string", "maxLength": 128 },
        "washCount": { "type": "number" },
        "co2SavedGrams": { "type": "number" }
      },
      "required": ["bagNumber", "type", "status", "qrToken"]
    },
    "activeBag": {
      "title": "ActiveBag",
      "description": "Borrowed eco-bag active loan record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "bagNumber": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "maxLength": 50 },
        "borrowedAt": { "type": "string", "maxLength": 60 },
        "borrowedStationId": { "type": "string", "maxLength": 50 },
        "borrowedStationName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "returned"] },
        "co2SavedGrams": { "type": "number" }
      },
      "required": ["userId", "bagNumber", "type", "borrowedStationId", "status"]
    },
    "activity": {
      "title": "ActivityLog",
      "description": "Eco bag borrowing and return timeline activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "bagNumber": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "maxLength": 30 }
      },
      "required": ["userId", "action", "bagNumber", "type"]
    },
    "stamp": {
      "title": "StampRecord",
      "description": "Loyalty stamp record on the APU passport",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "index": { "type": "number" },
        "isStamped": { "type": "boolean" },
        "stampedDate": { "type": "string", "maxLength": 50 },
        "bagRef": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "index", "isStamped"]
    },
    "voucher": {
      "title": "RewardVoucher",
      "description": "Single-use reward redemption voucher issued to student",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "rewardId": { "type": "string", "maxLength": 50 },
        "rewardName": { "type": "string", "maxLength": 100 },
        "pointsCost": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "redeemed", "expired"] },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["code", "rewardId", "pointsCost", "status"]
    },
    "campusTotal": {
      "title": "CampusTotal",
      "description": "Campus-wide collective environmental impact counters",
      "type": "object",
      "properties": {
        "totalBagsEliminated": { "type": "number" },
        "co2AvoidedKg": { "type": "number" },
        "treesEquivalent": { "type": "number" },
        "monthlyGoal": { "type": "number" },
        "activeCampusers": { "type": "number" }
      },
      "required": ["totalBagsEliminated", "monthlyGoal"]
    }
  },
  "firestore": {
    "/bags/{bagId}": {
      "schema": "globalBag",
      "description": "Global collection of all physical campus EcoCarry bags"
    },
    "/campus/{metricId}": {
      "schema": "campusTotal",
      "description": "University-wide sustainability impact counters"
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Individual student or staff profile document"
    },
    "/users/{userId}/bags/{bagId}": {
      "schema": "activeBag",
      "description": "Active borrowed bags for the user"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "activity",
      "description": "Recent activity logs for the user"
    },
    "/users/{userId}/stamps/{stampId}": {
      "schema": "stamp",
      "description": "Loyalty stamp slots for the user"
    },
    "/users/{userId}/vouchers/{voucherId}": {
      "schema": "voucher",
      "description": "Single-use reward vouchers redeemed by the student"
    }
  }
}
